GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3-flash-preview

PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-name
PHOENIX_PROJECT_NAME=traceforge
PHOENIX_TRACES_LIMIT=100
PHOENIX_EVAL_LIMIT=50

FIRESTORE_DATABASE=(default)

STRATEGY_HISTORY_LIMIT=200
EVAL_TRENDS_LIMIT=200
COMPARISON_REVIEWS_LIMIT=200
COMPARISON_FILENAMES_LIMIT=100

PR_MAX_FILES_PER_REVIEW=5
PR_MAX_DIFF_LINES=300
PR_MAX_HUNKS_PER_FILE=2

GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id
