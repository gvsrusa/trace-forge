# ── Google / Vertex AI ───────────────────────────────────────────────────────
# Use Vertex AI (required for Cloud Run + GCP hackathon track)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=<YOUR_GCP_PROJECT_ID>
GOOGLE_CLOUD_LOCATION=us-central1

# Model — confirm exact string on GCP Vertex AI console
GEMINI_MODEL=gemini-2.0-flash

# ── Arize Phoenix Cloud ───────────────────────────────────────────────────────
# Create account at app.phoenix.arize.com → Settings → API Keys
# Format: px_live_xxxxxxxxxxxxxxxxxxxx
PHOENIX_API_KEY=

# Copy "Hostname" from Phoenix → Settings (includes /s/<your-space>)
# Example: https://app.phoenix.arize.com/s/my-space
PHOENIX_COLLECTOR_ENDPOINT=

PHOENIX_PROJECT_NAME=traceforge

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_DATABASE=(default)

# ── Google Custom Search API ──────────────────────────────────────────────────
# Enable "Custom Search API" in GCP console → Create a Programmable Search Engine
# Get API key from GCP → APIs & Services → Credentials
GOOGLE_SEARCH_API_KEY=
# From your Programmable Search Engine → Overview → Search engine ID
GOOGLE_SEARCH_ENGINE_ID=
